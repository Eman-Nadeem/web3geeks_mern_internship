# Node Environment
NODE_ENV="development"

# Database Connections (Prisma)
# Production uses pooled Neon URL for DATABASE_URL and direct connection URL for DIRECT_URL
DATABASE_URL=""
DIRECT_URL=""
TEST_DATABASE_URL=""

# Auth Secrets (min 32 characters for HS256)
JWT_SECRET=""
JWT_EXPIRES_IN=""

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Upstash Redis Rate Limiting (Required in production, optional in development/testing with automatic in-memory fallback)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email Service (Resend - optional in dev, logged to console when absent)
RESEND_API_KEY=""
EMAIL_FROM=""

# Blob Storage (Vercel Blob - optional in dev)
BLOB_READ_WRITE_TOKEN=""

# Invitation Expiry
INVITATION_EXPIRES_IN_HOURS=72

# Real-Time WebSocket Service (Pusher - optional in dev, silent no-op when absent)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
