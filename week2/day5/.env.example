# ==============================================================================
# SyncDocs Environment Variables Template (Day 2)
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# --- AUTHENTICATION CONFIGURATION ---
# CRITICAL: Do NOT use a hardcoded value. Generate your unique 32+ char secret:
# Terminal command: openssl rand -base64 32
AUTH_SECRET=""

# --- NEXT.JS FRONTEND CONFIGURATION ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- REAL-TIME SOCKET.IO SERVER CONFIGURATION ---
# Local: http://localhost:3001 | Production (Render/Railway): https://syncdocs-socket.onrender.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT=3001
CORS_ORIGIN="http://localhost:3000"

# --- INTERNAL WEBSOCKET BRIDGE SECRET ---
# Secret used by Next.js Route Handlers to authenticate internal HTTP bridge calls to the Socket.IO service.
# Generate via: openssl rand -base64 32
INTERNAL_BRIDGE_SECRET=""

# --- CLOUDINARY IMAGE UPLOAD CONFIGURATION (Profile Pictures) ---
# Option A: API Key & Secret (Recommended for server-side upload)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Option B: Complete Connection URL (Alternative)
# CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# Option C: Unsigned Upload Preset (Alternative for unsigned client uploads)
# CLOUDINARY_UPLOAD_PRESET="your_upload_preset"

