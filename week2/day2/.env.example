# ==============================================================================
# SyncDocs Environment Variables Template (Day 2)
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# --- AUTHENTICATION CONFIGURATION ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# --- NEXT.JS FRONTEND CONFIGURATION ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- REAL-TIME SOCKET.IO SERVER CONFIGURATION ---
# Local: http://localhost:3001 | Production (Render/Railway): https://syncdocs-socket.onrender.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT=3001
CORS_ORIGIN="http://localhost:3000"
