generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum AdjustmentType {
  RESTOCK
  SALE
  MANUAL_ADJUSTMENT
  RETURN
  DAMAGE
}

enum PaymentMethod {
  COD
  MOCK_GATEWAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  EARNED
  REFUNDED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum FinancialTransactionType {
  PAYMENT
  SALE
  COMMISSION
  REFUND
  SETTLEMENT
  ADJUSTMENT
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

model User {
  id                        String                  @id @default(cuid())
  name                      String
  email                     String                  @unique
  passwordHash              String
  role                      UserRole                @default(CUSTOMER)
  vendor                    Vendor?
  adjustments               InventoryAdjustment[]
  cart                      Cart?
  orders                    Order[]
  payments                  Payment[]
  commissionSettingsCreated CommissionSetting[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Vendor {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  description           String?
  logoUrl               String?
  email                 String
  phone                 String?
  status                VendorStatus           @default(PENDING)
  ownerId               String                 @unique
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products              Product[]
  adjustments           InventoryAdjustment[]
  cartItems             CartItem[]
  vendorOrders          VendorOrder[]
  commissionRecords     CommissionRecord[]
  settlements           Settlement[]
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status])
  @@index([slug])
  @@index([createdAt])
}

model Product {
  id                String                @id @default(cuid())
  name              String
  slug              String                @unique
  description       String
  price             Decimal               @db.Decimal(12, 2)
  compareAtPrice    Decimal?              @db.Decimal(12, 2)
  stockQuantity     Int                   @default(0)
  sku               String
  lowStockThreshold Int                   @default(5)
  category          String
  status            ProductStatus         @default(ACTIVE)
  vendorId          String
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  variants          ProductVariant[]
  adjustments       InventoryAdjustment[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([vendorId, sku])
  @@index([vendorId])
  @@index([status])
  @@index([category])
  @@index([slug])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductVariant {
  id            String                @id @default(cuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  options       Json
  sku           String
  price         Decimal?              @db.Decimal(12, 2)
  stockQuantity Int                   @default(0)
  imageUrl      String?
  status        ProductStatus         @default(ACTIVE)
  adjustments   InventoryAdjustment[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model InventoryAdjustment {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  previousQuantity Int
  newQuantity      Int
  quantityChanged  Int
  adjustmentType   AdjustmentType
  reason           String?
  changedByUserId  String
  changedByUser    User            @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([productId])
  @@index([vendorId])
  @@index([variantId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([vendorId])
  @@index([productId])
}

model Order {
  id                    String                 @id @default(cuid())
  orderNumber           String                 @unique
  customerId            String
  customer              User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount           Decimal                @db.Decimal(12, 2)
  paymentMethod         String                 @default("MOCK_GATEWAY")
  paymentStatus         PaymentStatus          @default(PENDING)
  shippingName          String
  shippingEmail         String
  shippingPhone         String
  shippingAddress       String
  shippingCity          String
  shippingPostalCode    String?
  status                OrderStatus            @default(PENDING)
  vendorOrders          VendorOrder[]
  payments              Payment[]
  commissionRecords     CommissionRecord[]
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model VendorOrder {
  id                    String                 @id @default(cuid())
  vendorOrderNumber     String                 @unique
  orderId               String
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId              String
  vendor                Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  subtotal              Decimal                @db.Decimal(12, 2)
  shippingAmount        Decimal                @default(0) @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  status                OrderStatus            @default(PENDING)
  items                 OrderItem[]
  commissionRecord      CommissionRecord?
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([vendorOrderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                     String          @id @default(cuid())
  vendorOrderId          String
  vendorOrder            VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId              String?
  variant                ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot    String
  skuSnapshot            String
  unitPriceSnapshot      Decimal         @db.Decimal(12, 2)
  quantity               Int
  variantOptionsSnapshot Json?
  lineTotal              Decimal         @db.Decimal(12, 2)
  createdAt              DateTime        @default(now())

  @@index([vendorOrderId])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("PKR")
  method      PaymentMethod @default(MOCK_GATEWAY)
  referenceId String        @unique
  status      PaymentStatus @default(PENDING)
  provider    String        @default("mock-gateway")
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([referenceId])
  @@index([createdAt])
}

model CommissionSetting {
  id              String   @id @default(cuid())
  rate            Decimal  @db.Decimal(5, 4)
  effectiveFrom   DateTime @default(now())
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
  @@index([createdAt])
}

model CommissionRecord {
  id               String           @id @default(cuid())
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderId          String
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrderId    String           @unique
  vendorOrder      VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  grossAmount      Decimal          @db.Decimal(12, 2)
  commissionRate   Decimal          @db.Decimal(5, 4)
  commissionAmount Decimal          @db.Decimal(12, 2)
  vendorEarning    Decimal          @db.Decimal(12, 2)
  currency         String           @default("PKR")
  status           CommissionStatus @default(PENDING)
  settlementItem   SettlementItem?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Settlement {
  id               String           @id @default(cuid())
  settlementNumber String           @unique
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @default("PKR")
  periodStart      DateTime
  periodEnd        DateTime
  status           SettlementStatus @default(PENDING)
  paymentReference String?
  requestedAt      DateTime         @default(now())
  processedAt      DateTime?
  items            SettlementItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([settlementNumber])
  @@index([createdAt])
}

model SettlementItem {
  id                 String           @id @default(cuid())
  settlementId       String
  settlement         Settlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  commissionRecordId String           @unique
  commissionRecord   CommissionRecord @relation(fields: [commissionRecordId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([settlementId])
  @@index([createdAt])
}

model FinancialTransaction {
  id            String                   @id @default(cuid())
  vendorId      String?
  vendor        Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  vendorOrderId String?
  vendorOrder   VendorOrder?             @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  type          FinancialTransactionType
  amount        Decimal                  @db.Decimal(12, 2)
  direction     TransactionDirection
  referenceId   String?
  description   String
  createdAt     DateTime                 @default(now())

  @@index([vendorId])
  @@index([orderId])
  @@index([vendorOrderId])
  @@index([type])
  @@index([direction])
  @@index([createdAt])
  @@index([referenceId])
}
