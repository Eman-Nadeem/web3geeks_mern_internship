# PostgreSQL Database URL with pooling (Prisma runtime queries)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# PostgreSQL Direct URL for schema migrations & Prisma CLI
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Stateless JWT Authentication Secret (Required in production: openssl rand -base64 32)
JWT_SECRET="your-secure-random-jwt-secret-at-least-32-chars"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary Media Storage (Optional for product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Node Environment
NODE_ENV="development"
